{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "${workspaceFolder}/tools/node-v26.13.1-win-x64;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "Memoza: API",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8010",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "memoza" }
    },
    {
      "label": "Memoza: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "memoza" }
    },
    {
      "label": "Memoza: Dev (both)",
      "dependsOn": ["Memoza: API", "Memoza: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Memoza: Build frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Memoza: Smoke test",
      "type": "shell",
      "command": "python tests/smoke.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Memoza: Verify all",
      "dependsOn": ["Memoza: Build frontend", "Memoza: Smoke test"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
