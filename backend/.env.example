# DAYFLOW backend configuration
# Copy this file to .env and edit the values you need.

APP_NAME=DAYFLOW
ENVIRONMENT=local

# Replace this before deploying.
SECRET_KEY=dayflow-local-development-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite is the zero-setup default. For production, use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://dayflow:password@localhost:5432/dayflow
# Leave unset to use backend/dayflow.db.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://localhost:5180,http://127.0.0.1:5180
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Creates a clearly labelled demo workspace on first startup.
DEMO_SEED_ON_STARTUP=true

# Where a trained duration model is stored (only created after enough history).
MODEL_PATH=backend/duration_model.joblib

# Owner-only traffic dashboard. The matching account email sees the Traffic page.
OWNER_EMAIL=sashakolhatkar28@gmail.com
# Required when registering the reserved owner email. Use a long random value.
# In local development this may be left blank to keep the email reserved.
OWNER_SETUP_TOKEN=
TRAFFIC_SALT=replace-with-a-long-random-value-before-deployment
TRAFFIC_RETENTION_DAYS=180
